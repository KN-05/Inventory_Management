# Copy to client/.env
VITE_API_URL=http://localhost:5000/api

# Google sign-in (optional). The SAME Client ID goes in server/.env as GOOGLE_CLIENT_ID.
# Create it at https://console.cloud.google.com/apis/credentials ("OAuth client ID" ->
# "Web application") and add your site address (e.g. http://localhost:5173) under
# "Authorized JavaScript origins". Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=
