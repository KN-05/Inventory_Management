# Port the Express server will run on
PORT=5000

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/inventory_management
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/inventory_management
MONGO_URI=mongodb://127.0.0.1:27017/inventory_management

# Secret key used to sign JWT tokens - use a long random string in real use
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a JWT stays valid
JWT_EXPIRES_IN=7d

# The frontend's origin, for CORS - a single URL, no trailing slash
CLIENT_URL=http://localhost:5173
