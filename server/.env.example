# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/inventory_management
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/inventory_management
MONGO_URI=

# Secret used to sign login tokens. At least 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (Changing it later logs every user out.)
JWT_SECRET=

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS. Several? Separate with commas:
#   http://localhost:5173,https://inventory.example.com
CLIENT_URL=http://localhost:5173

# Gmail address + 16-character App Password used to send reset emails
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- Optional ---
# Set to 1 when the server runs behind a proxy / load balancer (Render, Nginx...)
# TRUST_PROXY=1
# Max requests per IP per 15 minutes for the whole API (default 1500)
# API_RATE_LIMIT=1500
# Turn all rate limits off (local debugging only)
# RATE_LIMIT_DISABLED=true
